# Copy this file to .env and fill it in (SETUP_GUIDE.md explains every line). Never commit .env.

# ---------------------------------------------------------------- mode
# true  = nothing is sent; WhatsApp and email are printed in the terminal (safe for testing)
# false = real WhatsApp messages and real emails
DRY_RUN=true

# ---------------------------------------------------------------- passwords you make up
# The VoiceOwl HTTP node must send this in the header X-Webhook-Token.
WEBHOOK_TOKEN=change-me-webhook-secret
# Opens the demo screen and the memory: https://<server>/demo?token=<ADMIN_TOKEN>
ADMIN_TOKEN=change-me-admin-secret

# ---------------------------------------------------------------- WhatsApp (Meta Cloud API)
# developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any word you choose; type the same word in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=smartfleet-demo
# App settings > Basic > App secret
WHATSAPP_APP_SECRET=

# Your own template (after Meta approves it):
WHATSAPP_TEMPLATE_NAME=smartfleet_call_summary
WHATSAPP_TEMPLATE_LANG=hi
WHATSAPP_TEMPLATE_HAS_SUMMARY=true
# Until it is approved, use Meta's ready-made template instead (comment out the 3 lines above):
# WHATSAPP_TEMPLATE_NAME=hello_world
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_TEMPLATE_HAS_SUMMARY=false

GRAPH_API_VERSION=v23.0

# ---------------------------------------------------------------- the model (WhatsApp replies)
# Groq (default). Pick a model id from console.groq.com/docs/models
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.4
# NVIDIA:        LLM_BASE_URL=https://integrate.api.nvidia.com/v1        LLM_MODEL=<model id from build.nvidia.com>
# Azure OpenAI:  LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/   LLM_MODEL=<your deployment name>
# If a model rejects "temperature", leave LLM_TEMPERATURE empty.

# ---------------------------------------------------------------- Gmail (support email)
GMAIL_ADDRESS=
# 16-letter App Password from myaccount.google.com/apppasswords (not your Gmail password)
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Bharat Petroleum Smart Fleet (demo)

# ---------------------------------------------------------------- the demo customer
DEMO_CUSTOMER_NAME=Suresh Yadav
DEMO_CUSTOMER_BUSINESS=Yadav Roadlines
# Where the demo email goes (your own inbox for the demo)
DEMO_CUSTOMER_EMAIL=
DEFAULT_COUNTRY_CODE=91
