# Copy to .env and fill in. Never commit .env.

# true = print WhatsApp and email instead of sending (safe for testing)
DRY_RUN=true

# Header X-Webhook-Token the VoiceOwl HTTP node must send. Leave empty to skip the check.
WEBHOOK_TOKEN=

# --- Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; type the same one in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=smartfleet-demo
# App settings > Basic > App secret. Leave empty to skip the signature check.
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=smartfleet_call_summary
WHATSAPP_TEMPLATE_LANG=hi
GRAPH_API_VERSION=v23.0

# --- The model for WhatsApp replies (any OpenAI-compatible API) ---
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=<a Groq model id>
# NVIDIA: LLM_BASE_URL=https://integrate.api.nvidia.com/v1 LLM_MODEL=<an NVIDIA model id>
# Azure:  LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/  LLM_MODEL=<deployment name>
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# --- Gmail (Google Account > Security > 2-Step Verification > App passwords) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- The demo customer ---
DEMO_CUSTOMER_NAME=Suresh Yadav
DEMO_CUSTOMER_BUSINESS=Yadav Roadlines
DEMO_CUSTOMER_EMAIL=
DEFAULT_COUNTRY_CODE=91
