# Copy to .env and fill in. Never commit .env.
PORT=8787
API_KEY=change-me-long-random-string

# Google (from Google Cloud console, OAuth client type "Desktop app"; refresh token from: node auth.mjs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALENDAR_ID=primary
# Optional: comma-separated emails also invited to every demo (e.g. Hussain when the calendar is not his)
EXTRA_ATTENDEES=

# Sales team hours (IST, Monday=1 ... Friday=5)
SALES_TZ=Asia/Kolkata
WORK_START_HOUR=9
WORK_END_HOUR=23
WORK_DAYS=1,2,3,4,5
# The prospect's own hours (their local time)
PROSPECT_START_HOUR=9
PROSPECT_END_HOUR=19

SLOT_MINUTES=15
GRID_MINUTES=15
BUFFER_MINUTES=0
MIN_NOTICE_MINUTES=10
WINDOW_DAYS=15
# Second offer: first free slot this many minutes after the first, trying each in turn, else the next free slot
SECOND_SLOT_GAPS_MINUTES=60,30
AVOID_FRIDAY=0

# Set to 1 to test without Google (in-memory calendar)
GOOGLE_MOCK=0

# Email: earlier emails for priorContext (/emailContext)
EMAIL_CONTEXT_MESSAGES=5
# Email replies (/checkReplies, /pendingReplies, /replyInThread). 0 = check only when /checkReplies is called.
EMAIL_POLL_SECONDS=60
EMAIL_LOOKBACK_DAYS=7
EMAIL_REPLIES_PER_DAY=3
EMAIL_REPLIES_TOTAL=10
EMAIL_REPLY_MAX_AGE_DAYS=30
